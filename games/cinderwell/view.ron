#![enable(implicit_some)]
// CINDERWELL: side-view shaft. custom projection maps x→screen-x, z→screen-y (y fixed=0).
View(
    theme: "dark",
    assets: ["landscape"],
    components: {
        "Sidebar": Rows([
            (Fixed(5),  C(name: "Env")),
            (Fill,      C(name: "Inspector")),
            (Fixed(6),  C(name: "Series", props: (names: ["kor.energy", "kor.rises", "count.culuf", "count.kul"]))),
            (Fixed(6),  C(name: "Counts")),
        ]),
    },
    layout: Rows([
        (Fixed(1), C(name: "Title")),
        (Fill, Cols([
            (Percent(55), Rows([
                (Percent(70), C(name: "World", props: (projection: (dim: "custom", n: 3, x: 0, y: 2, fixed: [(1, 0)], tint: "heat")))),
                (Fill, C(name: "World", props: (projection: (dim: "2.5D", perspectives: [
                    (name: "shaft", order: [0, 1, 2, 3, 4], focus: 0, step: (2, -1), fade: 40),
                ])))),
            ])),
            (Fill, C(name: "Sidebar")),
        ])),
        (Fixed(1), C(name: "Legend")),
        (Fixed(5), C(name: "Events", class: "calm")),
        (Fixed(1), C(name: "Help")),
    ]),
)

#![enable(implicit_some)]
// KOK: side-view soil column on the HD stage (sim-gpu, `simcraft-play games/kok`).
// World levels are depth (z); one row per level (y=0). Camera looks at the cross-section.
// Parallax backdrops sit above the cut; soil fill textures the undug rock.
Stage(
    assets: ["nature_hd"],
    cells_across: 20.0,
    horizon: 0.18,
    plane: 0,
    row_depth: 0.04,
    follow: "kok",
    sky: "sky",
    layers: [
        (image: "mountains",   depth: 30.0, height: 50.0, haze: 40, blur: 1.0),
        (image: "forest",      depth: 12.0, height: 14.0, haze: 20, blur: 0.5),
        (image: "meadow",      depth: 4.0,  height: 3.6,  haze: 6,  lift: -0.05),
        (image: "grass_front", depth: 1.0,  height: 0.28, lift: -0.08, offset: 5.0),
        (image: "grass_front", depth: 0.55, height: 0.5,  lift: -0.10, front: true, blur: 1.6, opacity: 0.95),
    ],
    soil: (image: "soil", scale: 4.0, hollow: "hollow", darken: 50),
    kinds: {
        // Stand-in nature_hd frames (no dedicated root sprites yet).
        "kok":   (frames: ["mound"], height: 0.55, bob: 0.006, fps: 6.0),
        "sivri": (frames: ["berry"], height: 0.28, bob: 0.01,  fps: 10.0),
        "dugum": (frames: ["granary"], height: 0.4),
    },
    buttons: [
        (action: "press_down", on: "kok", icon: "btn_warm",  key: "1", at: (0.07, 0.87)),
        (action: "branch_now", on: "kok", icon: "btn_rally", key: "2", at: (0.165, 0.87)),
    ],
    vignette: 32,
)

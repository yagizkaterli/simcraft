#![enable(implicit_some)]
// KOK: the root organism on an HD stage. A side-view soil column: the world's 30 levels (z) are the
// vertical depth, with 1 row per level (y=0). The camera looks at the cross-section, with parallax
// backdrops of the surface above and the soil layers receding.
Stage(
    assets: ["nature_hd"],
    cells_across: 20.0,
    horizon: 0.15,
    plane: 0,
    row_depth: 0.03,
    follow: "kok",
    sky: "sky",
    layers: [
        (image: "mountains",   depth: 30.0, height: 50.0, haze: 40, blur: 1.0),
        (image: "forest",      depth: 12.0, height: 14.0, haze: 20, blur: 0.5),
        (image: "meadow",      depth: 4.0,  height: 3.6,  haze: 6,  lift: -0.05),
        // Grass in front of the cut, showing the surface level.
        (image: "grass_front", depth: 1.0,  height: 0.28, lift: -0.08, offset: 5.0),
        (image: "grass_front", depth: 0.55, height: 0.5,  lift: -0.10, front: true, blur: 1.6, opacity: 0.95),
    ],
    soil: (image: "soil", scale: 4.0, hollow: "hollow", darken: 50),
    kinds: {
        "kok":   (frames: ["bush_bare"], height: 0.55, bob: 0.005, sink: 0.05),
        "sivri": (frames: ["ant_callow"], height: 0.32, bob: 0.008),
        "dugum": (frames: ["granary"], height: 0.4, sink: 0.06),
    },
    vignette: 30,
)

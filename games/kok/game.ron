#![enable(implicit_some)]
// KOK — an original 2.5D root-organism simulation.
//
// A Kok (main root body) grows downward through a layered soil column (toprak → kum → kil → kaya),
// branching Sivri (root tips) that extend sideways seeking nutrients, and forming Dugum (storage nodes)
// where nutrients are rich. Deterministic: no_float, only_i64, same seed → same game.
//
// End: Kok reaches the bottom → "rooted" (win). Kok's energy exhausted → "exhausted" (lose).
Game(
    name: "kok",

    fields: {
        "soil":     (init: 1),            // terrain: non-zero = solid
        "soil_type": (init: 0),           // 0=toprak, 1=kum, 2=kil, 3=kaya
        "nutrient":  (init: 0, diffusion: 6),  // diffuses through soil
        "moisture":  (init: 100, diffusion: 8), // diffuses through soil
    },
    terrain: "soil",

    kinds: {
        "kok": (glyph: 'K', fsm: "kok",
                props: { "energy": 1000, "depth": 0, "branched": 0 },
                senses: { "clock": "tick" }),
        "sivri": (glyph: 'S', fsm: "sivri",
                  props: { "dir": 0 },
                  senses: { "clock": "tick", "nutrient_here": "field(\"nutrient\")" }),
        "dugum": (glyph: 'D', fsm: "dugum",
                  props: { "stored": 0 },
                  senses: { "clock": "tick" }),
        // Hidden marker: spawned when Kok reaches bottom, triggers win condition.
        "win_flag": (glyph: ' ', hidden: true, props: {}),
    },

    params: {
        "growth_cost": 10,          // energy Kok spends per tick to grow 1 cell deeper (*10)
        "sivri_cost": 5,            // energy Kok spends per tick per Sivri (*10, i.e. 0.5)
        "nutrient_threshold": 20,   // nutrient level needed to form a Dugum
        "branch_interval": 4,       // Kok spawns Sivri every N cells of depth
        "dugum_yield": 8,           // energy a Dugum gives the Kok per tick
        "passive_absorb": 1,        // energy Kok absorbs from soil nutrients per tick
        "sivri_search_max": 6,      // max cells a Sivri extends before dying
    },

    layout: (
        cells: {
            't': { "soil": 1, "soil_type": 0, "nutrient": 8, "moisture": 90 },
            'k': { "soil": 1, "soil_type": 1, "nutrient": 4, "moisture": 65 },
            'i': { "soil": 1, "soil_type": 2, "nutrient": 18, "moisture": 45 },
            'r': { "soil": 1, "soil_type": 3, "nutrient": 2, "moisture": 25 },
        },
        legend: { 'K': "kok" },
        levels: [
            // z=0  surface
            ["ttttttttKttttttttttt"],
            // z=1..4  toprak (top 5)
            ["tttttttttttttttttttt"],
            ["tttttttttttttttttttt"],
            ["tttttttttttttttttttt"],
            ["tttttttttttttttttttt"],
            // z=5..14  kum (5-15)
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            ["kkkkkkkkkkkkkkkkkkkk"],
            // z=15..24  kil (15-25)
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            ["iiiiiiiiiiiiiiiiiiii"],
            // z=25..29  kaya (25-30)
            ["rrrrrrrrrrrrrrrrrrrr"],
            ["rrrrrrrrrrrrrrrrrrrr"],
            ["rrrrrrrrrrrrrrrrrrrr"],
            ["rrrrrrrrrrrrrrrrrrrr"],
            ["rrrrrrrrrrrrrrrrrrrr"],
        ],
    ),

    fsms: {
        "kok": (
            initial: "Growing",
            states: {
                "Growing": (rules: [
                    // Absorb nutrients from the current cell.
                    (name: "kok_absorb", then: [
                        Add("energy", "min(p.passive_absorb, field(\"nutrient\"))"),
                    ]),
                    // Grow downward: dig the cell below, then move into it.
                    (name: "grow_down", when: "me.z < 29 && me.energy >= p.growth_cost",
                     then: [
                         SetFieldAt("soil", "0", "0", "1", "0"),
                         Move3("0", "0", "1"),
                         Add("depth", "1"),
                         Add("energy", "-p.growth_cost"),
                     ]),
                    // Branch: spawn a Sivri to each side at regular depth intervals.
                    (name: "branch_left", when: "me.depth > 0 && me.depth % p.branch_interval == 0 && me.branched < 999",
                     then: [ Spawn("sivri"), Add("branched", "1") ]),
                    (name: "branch_right", when: "me.depth > 0 && me.depth % p.branch_interval == 0 && me.branched < 999",
                     then: [ Spawn("sivri"), Add("branched", "1") ]),
                    // Win: reached the bottom.
                    (name: "reach_bottom", when: "me.z >= 29",
                     then: [ Spawn("win_flag"), Despawn(Me), Emit("rooted") ]),
                    // Lose: ran out of energy.
                    (name: "exhausted", when: "me.energy <= 0",
                     then: [ Despawn(Me), Emit("exhausted") ]),
                ]),
            },
        ),

        "sivri": (
            initial: "Extending",
            states: {
                "Extending": (
                    enter: [
                        // Alternate direction based on spawn order: even id → left, odd → right.
                        Set("dir", "if me.id % 2 == 0 { -1 } else { 1 }"),
                        // Move one cell in the chosen direction immediately on spawn.
                        SetFieldAt("soil", "if me.id % 2 == 0 { -1 } else { 1 }", "0", "0", "0"),
                        Move("if me.id % 2 == 0 { -1 } else { 1 }", "0"),
                    ],
                    rules: [
                        // Sivri upkeep: costs energy from the Kok each tick.
                        (name: "upkeep", target: Nearest("kok"),
                         then: [ On(It, [ Add("energy", "-p.sivri_cost") ]) ]),
                        // Starve if the Kok can't pay.
                        (name: "starve", target: Nearest("kok"),
                         when: "it.energy < p.sivri_cost",
                         then: [ Despawn(Me) ]),
                        // Check for nutrients: if high enough, become a Dugum.
                        (name: "form_dugum", when: "sense.nutrient_here >= p.nutrient_threshold",
                         then: [ Spawn("dugum"), Despawn(Me), Emit("formed") ]),
                        // Extend left.
                        (name: "extend_left", when: "me.dir < 0 && me.x > 0",
                         then: [
                             SetFieldAt("soil", "-1", "0", "0", "0"),
                             Move("-1", "0"),
                         ]),
                        // Extend right.
                        (name: "extend_right", when: "me.dir > 0 && me.x < 19",
                         then: [
                             SetFieldAt("soil", "1", "0", "0", "0"),
                             Move("1", "0"),
                         ]),
                        // Hit edge: despawn.
                        (name: "hit_wall", when: "(me.dir < 0 && me.x <= 0) || (me.dir > 0 && me.x >= 19)",
                         then: [ Despawn(Me) ]),
                    ],
                ),
            },
        ),

        "dugum": (
            initial: "Store",
            states: {
                "Store": (rules: [
                    // Absorb nutrients from the soil and convert to stored energy.
                    (name: "dugum_absorb", then: [
                        Add("stored", "min(p.dugum_yield, field(\"nutrient\"))"),
                        SetField("nutrient", "max(0, field(\"nutrient\") - p.dugum_yield)"),
                    ]),
                    // Transfer stored energy to the Kok.
                    (name: "transfer", target: Nearest("kok"),
                     then: [ On(It, [ Add("energy", "me.stored") ]), Set("stored", "0") ]),
                ]),
            },
        ),
    },

    rules: [
        // Soil layers diffuse moisture and nutrients.
        // (handled by field diffusion in the field definitions above)
    ],

    end: [
        (when: "count.win_flag > 0", result: "rooted"),
        (when: "count.kok == 0",     result: "exhausted"),
    ],
)

#![enable(implicit_some)]
// BROOD — original creature-evolution simulation (OYUN-2).
// A brood swarm carries three heritable body traits (bulk, legs, diet).
// Environment pressure (moss seasons + prey cycles) shifts which mix survives.
// Offspring inherit nearest parent's traits with mutation. No floats; only i64.
// Distinct from forage (brain nets) and pollen_drift (color CA): body-trait selection.
Game(
    name: "brood",
    perception: Direct,

    kinds: {
        "wall": (glyph: '#', solid: true),
        "moss": (glyph: '.', solid: false, fsm: "moss",
                 props: { "stock": 3 },
                 glyphs: { "Ripe": '.', "Bare": ' ' }),
        "prey": (glyph: 'p', fsm: "prey",
                 props: { "energy": 8, "age": 0 },
                 glyphs: { "Alive": 'p', "Spent": 'x' }),
        "brood": (glyph: 'b', fsm: "brood",
                  props: {
                      "energy": 40,
                      "age": 0,
                      "bulk": 3,   // 1..9 capacity / cost
                      "legs": 3,   // 1..9 pace proxy
                      "diet": 2,   // 0=moss 1=prey 2=omni
                      "gen": 0,
                      "fed": 0
                  },
                  glyphs: {
                      "Forage": 'b',
                      "Hunt": 'B',
                      "Rest": 'o'
                  }),
        "marker": (glyph: '+', solid: true, fsm: "marker", props: { "best_gen": 0 }),
    },

    params: {
        "max_ticks": 400,
        "start_energy": 40,
        "max_energy": 120,
        "birth_at": 70,
        "birth_cost": 28,
        "max_brood": 48,
        "min_brood": 6,
        "lifespan": 160,
        "moss_gain": 10,
        "prey_gain": 16,
        "moss_regrow": 12,
        "moss_max": 3,
        "prey_spawn_every": 18,
        "prey_cap": 20,
        "base_burn": 1,
        "bulk_burn": 1,   // extra burn per (bulk-1)/2
        "legs_burn": 1,   // extra burn per (legs-1)/3
        "mut_span": 2,    // mutation +/- rand
        "arrive_every": 25,
        "win_gen": 4,
        "win_count": 8,
    },

    layout: (
        legend: {
            '#': "wall",
            '.': "moss",
            'p': "prey",
            'b': ("brood", { "bulk": 3, "legs": 3, "diet": 2, "energy": 40 }),
            'h': ("brood", { "bulk": 6, "legs": 2, "diet": 1, "energy": 45 }),
            's': ("brood", { "bulk": 2, "legs": 6, "diet": 0, "energy": 35 }),
            '+': "marker",
        },
        rows: [
            "############################",
            "#..........................#",
            "#..b................s......#",
            "#............p.............#",
            "#..........................#",
            "#......h...................#",
            "#............+.............#",
            "#..........................#",
            "#....p...............p.....#",
            "#..........................#",
            "#..........................#",
            "#............p.............#",
            "#..........................#",
            "############################",
        ],
    ),

    fsms: {
        "moss": (
            initial: "Ripe",
            states: { "Ripe": (), "Bare": () },
            transitions: [
                (from: "Ripe", to: "Bare", when: "me.stock == 0"),
                (from: "Bare", to: "Ripe", when: "me.stock > 0"),
            ],
        ),
        "prey": (
            initial: "Alive",
            states: {
                "Alive": (),
                "Spent": (enter: [ Set("energy", "0") ]),
            },
            transitions: [
                (from: "Alive", to: "Spent", when: "me.energy <= 0"),
            ],
        ),
        "brood": (
            initial: "Forage",
            states: {
                "Forage": (),
                "Hunt": (),
                "Rest": (),
            },
            transitions: [
                (from: "Forage", to: "Hunt",
                 when: "me.diet != 0 && near.prey <= 4 && me.energy < p.birth_at"),
                (from: "Hunt", to: "Forage",
                 when: "me.diet == 0 || near.prey > 6 || me.energy >= p.birth_at"),
                (from: "Forage", to: "Rest", when: "me.energy >= p.birth_at"),
                (from: "Hunt", to: "Rest", when: "me.energy >= p.birth_at"),
                (from: "Rest", to: "Forage", when: "me.energy < p.birth_at - 10"),
            ],
        ),
        "marker": (
            initial: "Hold",
            states: { "Hold": () },
            transitions: [],
        ),
    },

    rules: [
        // --- moss ---
        (name: "moss_regrow", for: "moss",
         when: "tick % p.moss_regrow == 0 && me.stock < p.moss_max",
         then: [ Add("stock", "1") ]),

        // --- prey life ---
        (name: "prey_age", for: "prey", state: "Alive",
         then: [ Add("age", "1"), Add("energy", "-1") ]),
        (name: "prey_wander", for: "prey", state: "Alive", then: [ Wander ]),
        (name: "prey_die", for: "prey", when: "me.energy <= 0 || me.age >= 80",
         then: [ Despawn(Me) ]),
        // seasonal prey influx (cycle pressure)
        (name: "prey_influx", for: "marker",
         when: "tick % p.prey_spawn_every == 0 && count.prey < p.prey_cap",
         then: [ Spawn("prey"), Emit("prey_spawn") ]),

        // --- brood metabolism (trait-cost) ---
        (name: "brood_age", for: "brood",
         then: [ Add("age", "1") ]),
        (name: "brood_burn", for: "brood",
         then: [ Add("energy", r#"- (p.base_burn + (me.bulk - 1) / 2 * p.bulk_burn + (me.legs - 1) / 3 * p.legs_burn)"#) ]),

        // move: legs bias pace via extra wander chance (deterministic roll)
        (name: "brood_step_forage", for: "brood", state: "Forage",
         when: "roll < (20 + me.legs * 8)",
         then: [ Wander ]),
        (name: "brood_step_hunt", for: "brood", state: "Hunt",
         when: "near.prey > 0 && roll < (30 + me.legs * 7)",
         then: [ MoveToward("prey") ]),
        (name: "brood_step_rest", for: "brood", state: "Rest",
         when: "roll < 15",
         then: [ Wander ]),

        // eat moss if herbivore/omni and adjacent
        (name: "eat_moss", for: "brood",
         when: r#"me.diet != 1 && near.moss <= 1 && nearest_prop("moss", "stock", 1, 0) > 0"#,
         then: [
             On(Nearest("moss"), [ Need("stock", "1"), Add("stock", "-1") ]),
             Add("energy", "min(p.max_energy - me.energy, p.moss_gain + (9 - me.bulk))"),
             Add("fed", "1"),
             Emit("ate_moss")
         ]),

        // eat prey if carnivore/omni: bulk helps catch (must be close; bulk>=4 can eat from 2)
        (name: "eat_prey", for: "brood",
         when: r#"me.diet != 0 && near.prey <= (if me.bulk >= 5 { 2 } else { 1 }) && count.prey > 0"#,
         then: [
             Despawn(Nearest("prey")),
             Add("energy", "min(p.max_energy - me.energy, p.prey_gain + me.bulk)"),
             Add("fed", "1"),
             Emit("ate_prey")
         ]),

        // birth: pay energy, spawn child; child picks traits next tick via born rule
        (name: "birth", for: "brood",
         when: "me.energy >= p.birth_at && count.brood < p.max_brood",
         then: [
             Add("energy", "-p.birth_cost"),
             Spawn("brood"),
             Emit("born")
         ]),

        // newborn inherits nearest older brood traits + mutation (age==0 sentinel)
        (name: "inherit_traits", for: "brood",
         when: "me.age == 0 && me.gen == 0 && count.brood > 1",
         then: [
             Set("bulk", r#"
                 if nearest_prop("brood", "bulk", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span) < 1 {
                     1
                 } else if nearest_prop("brood", "bulk", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span) > 9 {
                     9
                 } else {
                     nearest_prop("brood", "bulk", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span)
                 }
             "#),
             Set("legs", r#"
                 if nearest_prop("brood", "legs", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span) < 1 {
                     1
                 } else if nearest_prop("brood", "legs", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span) > 9 {
                     9
                 } else {
                     nearest_prop("brood", "legs", 6, 3) + (rand(p.mut_span * 2 + 1) - p.mut_span)
                 }
             "#),
             Set("diet", r#"
                 if roll < 18 {
                     rand(3)
                 } else {
                     nearest_prop("brood", "diet", 6, 2)
                 }
             "#),
             Set("gen", r#"nearest_prop("brood", "gen", 6, 0) + 1"#),
             Set("energy", "p.start_energy"),
             Emit("inherited")
         ]),

        // seed gen for initial layout creatures once
        (name: "seed_gen", for: "brood",
         when: "me.age == 1 && me.gen == 0",
         then: [ Set("gen", "1") ]),

        (name: "die_starved", for: "brood", when: "me.energy <= 0",
         then: [ Emit("starved"), Despawn(Me) ]),
        (name: "die_old", for: "brood", when: "me.age >= p.lifespan",
         then: [ Emit("aged_out"), Despawn(Me) ]),

        // rescue influx if population collapses
        (name: "arrive", for: "marker",
         when: "count.brood < p.min_brood && tick % p.arrive_every == 0",
         then: [ Spawn("brood"), Emit("arrived") ]),

        // track best generation on marker
        (name: "track_gen", for: "marker",
         when: r#"nearest_prop("brood", "gen", 99, 0) > me.best_gen"#,
         then: [ Set("best_gen", r#"nearest_prop("brood", "gen", 99, 0)"#) ]),
    ],

    actions: [],

    score: r#"count.brood * 10 + nearest_prop("marker", "best_gen", 1, 0) * 25"#,

    end: [
        (when: "count.brood == 0", result: "extinct"),
        (when: r#"nearest_prop("marker", "best_gen", 1, 0) >= p.win_gen && count.brood >= p.win_count"#, result: "adapted"),
        (when: "tick >= p.max_ticks", result: "drifted"),
    ],
)

#![enable(implicit_some)]
// BROOD: top-down-ish field on HD stage for shot evidence.
Stage(
    assets: ["nature_hd"],
    cells_across: 28.0,
    horizon: 0.22,
    plane: 0,
    row_depth: 0.05,
    follow: "brood",
    sky: "sky",
    layers: [
        (image: "meadow", depth: 6.0, height: 4.0, haze: 10),
        (image: "grass_front", depth: 1.2, height: 0.35, lift: -0.06),
    ],
    soil: (image: "soil", scale: 3.0, hollow: "hollow", darken: 40),
    kinds: {
        "brood":  (frames: ["mound"], height: 0.45, bob: 0.008, fps: 6.0),
        "prey":   (frames: ["berry"], height: 0.25, bob: 0.012, fps: 8.0),
        "moss":   (frames: ["grass_front"], height: 0.15),
        "marker": (frames: ["granary"], height: 0.35),
        "wall":   (frames: ["mound"], height: 0.5),
    },
    buttons: [],
    vignette: 28,
)

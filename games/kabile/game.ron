#![enable(implicit_some)]
// kabile-16x16-v1 — HERAKLES SIM world as a simcraft game.
// The 12 actors replay the task script of sim-fiziksel/kabile-niyetler.jsonl as
// per-actor FSM chains: one transition per tick, one Move per transition.
// The refusals are the engine's own: a4's first step (a5 is solid there) and a1's
// boundary step are blocked, exactly like IHLAL in hos-sim.
// a11/a12 are unauthorized in the sim (their moves were RED); here they never move.
Game(
    name: "kabile",
    perception: Direct,

    kinds: {
        "a1":  (glyph: '1', solid: true, fsm: "p1"),
        "a2":  (glyph: '2', solid: true, fsm: "p2"),
        "a3":  (glyph: '3', solid: true, fsm: "p3"),
        "a4":  (glyph: '4', solid: true, fsm: "p4"),
        "a5":  (glyph: '5', solid: true, fsm: "p5"),
        "a6":  (glyph: '6', solid: true, fsm: "p6"),
        "a7":  (glyph: '7', solid: true, fsm: "p7"),
        "a8":  (glyph: '8', solid: true, fsm: "p8"),
        "a9":  (glyph: '9', solid: true, fsm: "p9"),
        "a10": (glyph: 'A', solid: true, fsm: "p10"),
        "a11": (glyph: 'B', solid: true),
        "a12": (glyph: 'C', solid: true),
    },

    params: {},

    fsms: {
        // a1: sag3 -> asagi2 -> sol3 -> [sinir: engelli] -> yukari2
        "p1": (initial: "s0", transitions: [
            (from: "s0",  to: "s1",  when: "true", then: [Move("1", "0")]),
            (from: "s1",  to: "s2",  when: "true", then: [Move("1", "0")]),
            (from: "s2",  to: "s3",  when: "true", then: [Move("1", "0")]),
            (from: "s3",  to: "s4",  when: "true", then: [Move("0", "1")]),
            (from: "s4",  to: "s5",  when: "true", then: [Move("0", "1")]),
            (from: "s5",  to: "s6",  when: "true", then: [Move("-1", "0")]),
            (from: "s6",  to: "s7",  when: "true", then: [Move("-1", "0")]),
            (from: "s7",  to: "s8",  when: "true", then: [Move("-1", "0")]),
            (from: "s8",  to: "s9",  when: "true", then: [Move("-1", "0")]),
            (from: "s9",  to: "s10", when: "true", then: [Move("0", "-1")]),
            (from: "s10", to: "s11", when: "true", then: [Move("0", "-1")]),
        ]),
        // a2 / a3: sag3 -> asagi2 -> sol3 -> yukari2
        "p2": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("1", "0")]),
            (from: "s1", to: "s2", when: "true", then: [Move("1", "0")]),
            (from: "s2", to: "s3", when: "true", then: [Move("1", "0")]),
            (from: "s3", to: "s4", when: "true", then: [Move("0", "1")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("-1", "0")]),
            (from: "s6", to: "s7", when: "true", then: [Move("-1", "0")]),
            (from: "s7", to: "s8", when: "true", then: [Move("-1", "0")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "-1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "-1")]),
        ]),
        "p3": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("1", "0")]),
            (from: "s1", to: "s2", when: "true", then: [Move("1", "0")]),
            (from: "s2", to: "s3", when: "true", then: [Move("1", "0")]),
            (from: "s3", to: "s4", when: "true", then: [Move("0", "1")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("-1", "0")]),
            (from: "s6", to: "s7", when: "true", then: [Move("-1", "0")]),
            (from: "s7", to: "s8", when: "true", then: [Move("-1", "0")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "-1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "-1")]),
        ]),
        // a4: cakisma denemesi (engelli) -> sag -> asagi2 -> sag -> yukari2 -> sol -> asagi -> yukari
        "p4": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("0", "1")]),
            (from: "s1", to: "s2", when: "true", then: [Move("1", "0")]),
            (from: "s2", to: "s3", when: "true", then: [Move("0", "1")]),
            (from: "s3", to: "s4", when: "true", then: [Move("0", "1")]),
            (from: "s4", to: "s5", when: "true", then: [Move("1", "0")]),
            (from: "s5", to: "s6", when: "true", then: [Move("0", "-1")]),
            (from: "s6", to: "s7", when: "true", then: [Move("0", "-1")]),
            (from: "s7", to: "s8", when: "true", then: [Move("-1", "0")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "-1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "1")]),
        ]),
        // a5: 2 tick bekle (a4'un cakisma denemesi a5 yerinde dururken engellensin), sonra salinim
        "p5": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true"),
            (from: "s1", to: "s2", when: "true"),
            (from: "s2", to: "s3", when: "true", then: [Move("0", "-1")]),
            (from: "s3", to: "s4", when: "true", then: [Move("0", "1")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "-1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("0", "1")]),
            (from: "s6", to: "s7", when: "true", then: [Move("0", "-1")]),
            (from: "s7", to: "s8", when: "true", then: [Move("0", "1")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "-1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "1")]),
        ]),
        "p6": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("0", "-1")]),
            (from: "s1", to: "s2", when: "true", then: [Move("0", "-1")]),
            (from: "s2", to: "s3", when: "true", then: [Move("1", "0")]),
            (from: "s3", to: "s4", when: "true", then: [Move("1", "0")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("0", "1")]),
            (from: "s6", to: "s7", when: "true", then: [Move("1", "0")]),
            (from: "s7", to: "s8", when: "true", then: [Move("0", "-1")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "-1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("-1", "0")]),
        ]),
        "p7": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("1", "0")]),
            (from: "s1", to: "s2", when: "true", then: [Move("0", "1")]),
            (from: "s2", to: "s3", when: "true", then: [Move("0", "1")]),
            (from: "s3", to: "s4", when: "true", then: [Move("-1", "0")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "-1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("0", "-1")]),
            (from: "s6", to: "s7", when: "true", then: [Move("1", "0")]),
            (from: "s7", to: "s8", when: "true", then: [Move("0", "1")]),
            (from: "s8", to: "s9", when: "true", then: [Move("0", "1")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "-1")]),
        ]),
        "p8": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("1", "0")]),
            (from: "s1", to: "s2", when: "true", then: [Move("0", "1")]),
            (from: "s2", to: "s3", when: "true", then: [Move("0", "1")]),
            (from: "s3", to: "s4", when: "true", then: [Move("-1", "0")]),
            (from: "s4", to: "s5", when: "true", then: [Move("-1", "0")]),
            (from: "s5", to: "s6", when: "true", then: [Move("0", "-1")]),
            (from: "s6", to: "s7", when: "true", then: [Move("0", "-1")]),
            (from: "s7", to: "s8", when: "true", then: [Move("1", "0")]),
            (from: "s8", to: "s9", when: "true", then: [Move("1", "0")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "1")]),
        ]),
        "p9": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("0", "1")]),
            (from: "s1", to: "s2", when: "true", then: [Move("0", "1")]),
            (from: "s2", to: "s3", when: "true", then: [Move("-1", "0")]),
            (from: "s3", to: "s4", when: "true", then: [Move("0", "-1")]),
            (from: "s4", to: "s5", when: "true", then: [Move("0", "-1")]),
            (from: "s5", to: "s6", when: "true", then: [Move("1", "0")]),
            (from: "s6", to: "s7", when: "true", then: [Move("0", "1")]),
            (from: "s7", to: "s8", when: "true", then: [Move("0", "1")]),
            (from: "s8", to: "s9", when: "true", then: [Move("-1", "0")]),
            (from: "s9", to: "s10", when: "true", then: [Move("0", "-1")]),
        ]),
        "p10": (initial: "s0", transitions: [
            (from: "s0", to: "s1", when: "true", then: [Move("1", "0")]),
            (from: "s1", to: "s2", when: "true", then: [Move("1", "0")]),
            (from: "s2", to: "s3", when: "true", then: [Move("0", "-1")]),
            (from: "s3", to: "s4", when: "true", then: [Move("-1", "0")]),
            (from: "s4", to: "s5", when: "true", then: [Move("-1", "0")]),
            (from: "s5", to: "s6", when: "true", then: [Move("1", "0")]),
            (from: "s6", to: "s7", when: "true", then: [Move("1", "0")]),
            (from: "s7", to: "s8", when: "true", then: [Move("0", "1")]),
            (from: "s8", to: "s9", when: "true", then: [Move("-1", "0")]),
            (from: "s9", to: "s10", when: "true", then: [Move("-1", "0")]),
        ]),
    },

    rules: [],

    // Baslangic konumlari: kabile-dunya.json ile birebir.
    layout: (
        legend: { '1': "a1", '2': "a2", '3': "a3", '4': "a4", '5': "a5", '6': "a6",
                  '7': "a7", '8': "a8", '9': "a9", 'A': "a10", 'B': "a11", 'C': "a12" },
        rows: [
            "1...............",
            "..............9.",
            ".......6........",
            "................",
            "............7...",
            ".....2..........",
            "......B.........",
            "................",
            "...4............",
            "...5.....C......",
            "..........3.....",
            "................",
            "........8.......",
            "................",
            ".A..............",
            "................",
        ],
    ),
)

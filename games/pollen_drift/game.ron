#![enable(implicit_some)]
// Pollen Drift — flower biodiversity cellular automaton.
// Every cell is a patch of flowers with a lifecycle and colour.
// Colours spread to neighbouring cells, creating hybrid colours
// when two different base colours (1=Red, 2=Blue, 3=Yellow) meet.
// Hybrids: 4=Purple (R+B), 5=Orange (R+Y), 6=Green (B+Y).
Game(
    name: "pollen_drift",
    perception: Direct,

    kinds: {
        "cell": (glyph: '.', solid: true, fsm: "cell",
                 props: { "color": 0, "age": 0 },
                 glyphs: {
                     "Barren": '.', "Seedling": ',',
                     "Bloom": '*', "Wilt": 'w', "Dead": '+',
                 }),
    },

    params: {
        "bloom_at": 6,
        "wilt_at": 40,
        "die_at": 55,
        "rest_at": 8,
        "spread_chance": 10,
        "inherit_chance": 65,
        "spd_1": -8, "spd_2": 12, "spd_3": 2,
        "spd_4": 6,  "spd_5": 4,  "spd_6": 8,
    },

    layout: (
        legend: {
            '.': "cell",
            'r': ("cell", { "color": 1 }),
            'b': ("cell", { "color": 2 }),
            'y': ("cell", { "color": 3 }),
        },
        rows: [
            "................................",
            "................................",
            "................................",
            "................................",
            "................................",
            ".....r..........................",
            "................................",
            "................................",
            "................................",
            "................................",
            "..............b.................",
            "................................",
            "................................",
            "................................",
            "................................",
            ".........................y......",
            "................................",
            "................................",
            "................................",
            "................................",
        ],
    ),

    fsms: {
        "cell": (
            initial: "Barren",
            states: {
                "Barren": (),
                "Seedling": (enter: [ Set("age", "0") ]),
                "Bloom": (),
                "Wilt": (),
                "Dead": (enter: [ Set("age", "0") ]),
            },
            transitions: [
                (from: "Barren",  to: "Seedling", when: "true"),
                (from: "Seedling", to: "Bloom", when: "me.age >= p.bloom_at"),
                (from: "Bloom",    to: "Wilt",
                 when: "me.age >= p.wilt_at + if me.color == 1 { p.spd_1 } else if me.color == 2 { p.spd_2 } else if me.color == 3 { p.spd_3 } else if me.color == 4 { p.spd_4 } else if me.color == 5 { p.spd_5 } else { p.spd_6 }"),
                (from: "Wilt",     to: "Dead",  when: "me.age >= 12"),
                (from: "Dead",     to: "Barren", when: "me.age >= p.rest_at"),
            ],
            rules: [
                // Age all non-barren states.
                (name: "age_nonbarren",
                 when: "!in_state(\"Barren\")",
                 then: [ Add("age", "1") ]),
                // Set colour on first tick as a Seedling.
                (name: "set_colour",
                 when: "in_state(\"Seedling\") && me.age == 0 && me.color == 0",
                 then: [ Set("color", r#"
                    if around("cell", "Bloom", 1) == 0 {
                        // No blooms nearby: random base colour.
                        1 + rand(3)
                    } else if roll < p.inherit_chance {
                        // Inherit nearest bloom's colour.
                        nearest_prop("cell", "color", 1, 1)
                    } else if roll < 50 {
                        // Mutation to a random base colour.
                        1 + rand(3)
                    } else {
                        // Cross-pollination: random hybrid colour.
                        4 + rand(3)
                    }
                 "#) ]),
            ],
        ),
    },

    rules: [],
    actions: [],
)
